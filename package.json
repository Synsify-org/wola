{
  "name": "wola",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "migrate": "node scripts/migrate.mjs",
    "test:isolation": "node --import tsx --import dotenv/config --test packages/db/test/*.test.mjs",
    "process-email-outbox": "node --import tsx --import dotenv/config scripts/process-email-outbox.mjs"
  },
  "dependencies": {
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "tsx": "^4.23.0"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true
  }
}
