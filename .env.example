# Admin URL: migrations only. Never give this to the app.
DATABASE_ADMIN_URL=postgres://wola_admin:admin_dev@localhost:5432/wola
# App URL: what apps/web and the worker use. RLS-bound role.
DATABASE_URL=postgres://wola_app:app_dev@localhost:5432/wola
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=wola
S3_SECRET_KEY=wola_dev_secret
SMTP_URL=smtp://localhost:1025

# Two-step sign-in. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave unset to keep two-step sign-in switched off; set it BEFORE telling any
# administrator to require it. Losing or changing this key makes every enrolled
# authenticator unusable (people would need recovery codes), so store it in a
# secrets manager.
MFA_ENCRYPTION_KEY=


